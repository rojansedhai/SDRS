# Demo mode: set to 'true' for local simulation without AWS, or 'false' to connect to deployed AWS backend
VITE_DEMO_MODE=true

# AWS API Gateway URL (set after deploying the backend)
VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/

# API key for the simulator API (optional, if configured)
VITE_API_KEY=
