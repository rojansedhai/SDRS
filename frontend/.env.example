# SDRS Frontend Environment Variables Configuration Template
# Copy this file to .env and provide your actual infrastructure outputs

# Toggle local mock simulation (true) vs live AWS HTTP API (false)
VITE_DEMO_MODE=true

# Regional API Gateway Base URL (e.g. from sam deploy outputs)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Authoritative Cognito User Pool & App Client IDs
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Pre-configured Cognito JWT Bearer Token for headless testing
VITE_AUTH_TOKEN=
